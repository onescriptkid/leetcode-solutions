/**
 * @param {number[][]} graph
 * @return {boolean}
 */
var isBipartite = function(graph) {
  let reds = new Set()
  let blues = new Set()

  for(let u = 0; u < graph.length; u++) {
    if(reds.has(u) || blues.has(u)) continue

    if(dfs(u, -1, 'red') === false) return false
  }

  return true

  function dfs(u, p, color) {
    if(color === 'red') reds.add(u)
    if(color === 'blue') blues.add(u)

    let nextcolor = color === 'blue' ? 'red' : 'blue'

    for(let v of graph[u]) {
      if(v === p) continue
      if(nextcolor === 'red' && blues.has(v)) return false
      if(nextcolor === 'blue' && reds.has(v)) return false

      if(reds.has(v) || blues.has(v)) continue
      if(dfs(v,u, nextcolor) === false) return false
    }

    return true
  }
};